---
import { getImage, Image } from 'astro:assets';
import site from '../data/site.json';
import SiteLayout from '../layouts/SiteLayout.astro';
import { externalLink, homePath, locales, tourPath, travelImage, youtubeChannel, type Locale } from '../lib/site';
import { getTours, tourTitle } from '../lib/strapi';
import Icon from './Icon.astro';
import TourCard from './TourCard.astro';
import RecommendationVideos from './RecommendationVideos.astro';

interface Props { locale: Locale }

const { locale } = Astro.props;
const copy = site.copy[locale];
const alternatives = Object.fromEntries(locales.map((language) => [language, homePath(language)]));
const { tours, unavailable } = await getTours(locale);
const byDocument = new Map(tours.map((tour) => [tour.documentId, tour]));
const curated = site.featuredTours.flatMap(({ documentId }) => {
  const tour = byDocument.get(documentId);
  return tour ? [tour] : [];
});
const featuredTours = curated.length ? curated : tours.slice(0, 9);
const featuredIds = new Set(featuredTours.map(({ documentId }) => documentId));
const otherTours = tours.filter(({ documentId }) => !featuredIds.has(documentId));
const heroImages = site.hero.map((slide) => ({ ...slide, src: travelImage(slide.image) }));
const social = await getImage({ src: heroImages[0].src });
const description = copy.homeDescription;
const slideControl = 'absolute top-1/2 grid size-11 -translate-y-1/2 place-items-center rounded-full text-white hover:bg-[#1a24185e] focus-visible:outline-white [&_svg]:drop-shadow-[0_1px_3px_#1a2418]';
---
<SiteLayout
  {locale}
  {alternatives}
  title={`${site.brand} | ${copy.tours}`}
  description={copy.metaDescription}
  socialImage={social.src}
  showAwards
>
  <section class="home-lead mx-auto w-full max-w-(--site-width) px-[clamp(0.75rem,1.4vi,1.25rem)]" aria-labelledby="home-title">
    <div class="hero flex snap-x snap-mandatory overflow-x-auto overscroll-x-contain [scrollbar-width:none] motion-safe:scroll-smooth [&::-webkit-scrollbar]:hidden" role="region" aria-label={copy.heroGallery} tabindex="0">
      {heroImages.map((slide, index) => {
        const previous = heroImages[index - 1];
        const next = heroImages[index + 1];
        return (
          <div class="hero-slide relative flex-[0_0_100%] snap-center bg-forest target:scroll-mt-48 focus-visible:-outline-offset-4" id={slide.image} tabindex="-1">
            <Image
              class="aspect-[3.25] w-full max-w-none object-cover max-[42rem]:aspect-[2.3]"
              src={slide.src}
              alt={slide.alt[locale]}
              layout="constrained"
              widths={[480, 720, 960, 1200]}
              sizes="(min-width: 90rem) 1400px, 100vw"
              loading={index === 0 ? 'eager' : 'lazy'}
              fetchpriority={index === 0 ? 'high' : 'low'}
            />
            {previous && (
              <a class:list={['hero-control hero-prev start-[0.45rem] [&_svg]:rotate-90', slideControl]} href={`#${previous.image}`} aria-label={copy.previousPhoto}>
                <Icon name="chevron" size={30} />
              </a>
            )}
            {next && (
              <a class:list={['hero-control hero-next end-[0.45rem] [&_svg]:-rotate-90', slideControl]} href={`#${next.image}`} aria-label={copy.nextPhoto}>
                <Icon name="chevron" size={30} />
              </a>
            )}
          </div>
        );
      })}
    </div>
    <div class="home-intro px-[0.35rem] pt-2">
      <h1 id="home-title" class="text-[clamp(1.25rem,0.95rem+1vi,1.9rem)] leading-[1.22] font-[450] text-[#60753e]">{copy.homeTitle}</h1>
      <p class="mt-[0.3rem] leading-[1.38]"><strong>{description.lead}</strong>{' '}{description.body}{' '}<a href={youtubeChannel} {...externalLink} class="text-[#254ba1] underline underline-offset-[0.18em]">{description.reviews}</a>{description.closing}</p>
    </div>
  </section>

  <div class="shell discovery grid gap-x-[clamp(1rem,2.2vi,2rem)] gap-y-8 pt-[clamp(1.85rem,3.6vi,3.2rem)] pb-[clamp(3rem,5vi,5.25rem)]
    [&>*]:grid [&>*]:min-w-0 [&>*]:content-start [&>*]:gap-y-[0.9rem]
    min-[74rem]:grid-cols-[minmax(0,2.75fr)_minmax(0,1fr)] min-[74rem]:gap-y-[0.9rem]
    min-[74rem]:[&>*]:row-span-2 min-[74rem]:[&>*]:grid-rows-[minmax(2.2rem,auto)_auto]
    min-[74rem]:supports-[grid-template-rows:subgrid]:[&>*]:grid-rows-subgrid min-[74rem]:[&>*>h2]:self-end">
    <section id="tours" aria-labelledby="tours-title">
      <h2 id="tours-title" class="tour-heading text-[clamp(1.32rem,1.02rem+0.85vi,1.82rem)] leading-[1.2] font-extrabold tracking-[-0.03em]">{copy.tourTitle}</h2>
      <div>
        {featuredTours.length > 0 ? (
          <ul class="tour-grid grid gap-[clamp(0.55rem,0.85vi,0.8rem)] min-[34rem]:grid-cols-2 min-[64rem]:grid-cols-3 [&>li]:grid [&>li]:min-w-0" role="list">
            {featuredTours.map((tour) => <li><TourCard {tour} /></li>)}
          </ul>
        ) : (
          <p class="tour-status rounded-lg border border-line p-4 text-muted">{unavailable ? copy.tourUnavailable : copy.tourEmpty}</p>
        )}

        {otherTours.length > 0 && (
          <details class="catalog group mt-[1.35rem]">
            <summary class="inline-flex min-h-11 items-center gap-[1.2rem] rounded-[0.45rem] border border-[#aeb99a] px-[0.9rem] text-sm font-[750] text-forest hover:bg-mist group-open:bg-mist group-open:[&_svg]:rotate-180 [&::-webkit-details-marker]:hidden">{copy.moreTours} <Icon name="chevron" size={18} /></summary>
            <ul class="mt-[0.8rem] divide-y divide-line" role="list">
              {otherTours.map((tour) => (
                <li><a href={tourPath(locale, tour.slug)} class="flex min-h-11 items-center justify-between gap-[0.7rem] px-[0.2rem] py-[0.65rem] text-[0.9rem] hover:underline">{tourTitle(tour)} <Icon name="arrow" size={17} /></a></li>
              ))}
            </ul>
          </details>
        )}
      </div>
    </section>

    <RecommendationVideos {locale} />
  </div>
</SiteLayout>
