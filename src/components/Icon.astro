  pin: '<path d="M20 10c0 5-8 11-8 11s-8-6-8-11a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/>',
  whatsapp: '<path d="M20.5 11.8a8.5 8.5 0 0 1-12.6 7.4L4 20.2l1-3.8a8.5 8.5 0 1 1 15.5-4.6Z"/><path d="M9 8.3c-.4.2-.8.8-.7 1.6.1 1.1 1 2.5 2.2 3.5 1.2 1 2.7 1.6 3.7 1.4.7-.1 1.2-.6 1.4-1l-2-1.1-.7.6c-1.2-.4-2.4-1.5-2.8-2.5l.5-.8L9 8.3Z"/>',
