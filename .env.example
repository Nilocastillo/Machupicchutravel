# URL de Strapi para el build. En Workers Builds, usa una URL accesible desde Cloudflare.
STRAPI_URL=http://127.0.0.1:1337
# Opcional si Strapi permite la lectura pública. En Workers Builds, guárdalo como secreto de compilación.
STRAPI_READ_TOKEN=
# URL pública del frontend, para enlaces canónicos y alternativos por idioma.
SITE_URL=
